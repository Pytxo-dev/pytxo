{
  "name": "pytxo-demo-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts PytxoLaunchDemo out/pytxo-launch-demo.mp4",
    "render:voiceover": "remotion render src/index.ts PytxoLaunchDemo out/pytxo-launch-demo-voiceover.mp4 --props=voiceover-props.json",
    "still": "remotion still src/index.ts PytxoLaunchDemo out/pytxo-launch-demo-still.png --frame=840",
    "voiceover": "node scripts/generate-voiceover.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@remotion/cli": "4.0.502",
    "@remotion/media": "4.0.502",
    "@remotion/transitions": "4.0.502",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.502"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
