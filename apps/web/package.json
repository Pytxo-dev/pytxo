    "deploy": "vercel deploy --prod --yes",
    "e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "shoot:sections": "node scripts/shoot-sections.mjs",
    "lint": "eslint",
    "sync:product-assets": "node scripts/sync-product-assets.mjs",
    "verify:product-assets": "node scripts/verify-product-assets.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.0",
    "@clerk/themes": "2.4.57",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/sora": "^5.3.0",
    "@pytxo/chroma": "file:./vendor/chroma",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.12.1",
    "lucide-react": "^1.17.0",
    "motion": "13.2.0",
    "next": "16.3.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.10.0",
    "sharp": "0.35.5",
    "simple-icons": "^16.27.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24"
    },
    "nanoid": "3.3.18",
    "browserslist": "4.28.7",
    "sharp": "$sharp"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.24",
      "nanoid": "3.3.18",
