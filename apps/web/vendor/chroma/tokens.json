{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "pytxo-chroma",
  "version": "0.3.4",
  "description": "Machine-readable Chroma design tokens. Sync with tokens.css and crates/pytxo-tui/src/theme.rs",
  "colors": {
    "void": { "hex": "#020205", "rgb": [2, 2, 5] },
    "card": { "hex": "#0a0a0f", "rgb": [10, 10, 15] },
    "foreground": { "hex": "#f4f4f5", "rgb": [244, 244, 245] },
    "mutedForeground": { "hex": "#9494a8", "rgb": [148, 148, 168] },
    "border": { "hex": "#27272a", "rgb": [39, 39, 42] },
    "brandTeal": { "hex": "#2dd4bf", "rgb": [45, 212, 191] },
    "brandViolet": { "hex": "#a78bfa", "rgb": [167, 139, 250] },
    "brandGold": { "hex": "#fbbf24", "rgb": [251, 191, 36] },
    "brandMagenta": { "hex": "#e879f9", "rgb": [232, 121, 249] },
    "brandCyan": { "hex": "#22d3ee", "rgb": [34, 211, 238] },
    "ok": { "hex": "#4ade80", "rgb": [74, 222, 128] },
    "err": { "hex": "#f87171", "rgb": [248, 113, 113] }
  },
  "chromaCycle": ["brandMagenta", "brandGold", "brandCyan", "brandViolet"],
  "radius": "0.625rem"
}
