{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "pytxo-chroma",
  "version": "0.6.0",
  "description": "Machine-readable Chroma Aperture tokens. Sync with tokens.css and crates/pytxo-tui/src/theme.rs",
  "colors": {
    "void": { "hex": "#050507", "rgb": [5, 5, 7] },
    "card": { "hex": "#101012", "rgb": [16, 16, 18] },
    "foreground": { "hex": "#F5F5F7", "rgb": [245, 245, 247] },
    "mutedForeground": { "hex": "#A1A1AA", "rgb": [161, 161, 170] },
    "border": { "hex": "#27272A", "rgb": [39, 39, 42] },
    "brandViolet": { "hex": "#F04DA3", "rgb": [240, 77, 163] },
    "brandMagenta": { "hex": "#F04DA3", "rgb": [240, 77, 163] },
    "brandOrange": { "hex": "#FF6A4A", "rgb": [255, 106, 74] },
    "brandGold": { "hex": "#F3C64E", "rgb": [243, 198, 78] },
    "brandTeal": { "hex": "#79E07B", "rgb": [121, 224, 123] },
    "brandCyan": { "hex": "#45DCCB", "rgb": [69, 220, 203] },
    "ok": { "hex": "#79E07B", "rgb": [121, 224, 123] },
    "err": { "hex": "#D96B6B", "rgb": [217, 107, 107] }
  },
  "chromaCycle": ["brandViolet", "brandMagenta", "brandOrange", "brandGold", "brandTeal", "brandCyan"],
  "epistemicState": {
    "description": "One entry per value of EnforcementSurface.status and RunApplyAttempt.outcome. Only verified, refuted, and attention carry hue; claimed and unknown are neutral because absence of proof is not a severity.",
    "dark": {
      "verified": { "hex": "#5BBF8A", "rgb": [91, 191, 138] },
      "refuted": { "hex": "#E0674C", "rgb": [224, 103, 76] },
      "attention": { "hex": "#8B7CF0", "rgb": [139, 124, 240] },
      "claimed": { "hex": "#AAAAB3", "rgb": [170, 170, 179] },
      "unknown": { "hex": "#8B8B95", "rgb": [139, 139, 149] }
    },
    "light": {
      "verified": { "hex": "#1E7A52", "rgb": [30, 122, 82] },
      "refuted": { "hex": "#B23A1F", "rgb": [178, 58, 31] },
      "attention": { "hex": "#5341C9", "rgb": [83, 65, 201] },
      "claimed": { "hex": "#52525B", "rgb": [82, 82, 91] },
      "unknown": { "hex": "#64748B", "rgb": [100, 116, 139] }
    }
  },
  "radius": "0.25rem"
}
