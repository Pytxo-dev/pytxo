{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pytxo Desktop",
  "version": "1.2.3",
  "identifier": "com.pytxo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pytxo Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.pytxo.com https://link.pytxo.com https://proxy.pytxo.com https://cloud.pytxo.com https://github.com https://pytxo.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "Pytxo"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pytxo",
          "pytxo-deck"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/Pytxo-dev/pytxo-releases/main/latest.json",
        "https://github.com/Pytxo-dev/pytxo-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERUIwNzVGNTZFODhCNTgKUldSWWkraFdYd2ZybllFaDNFVDFwSFcrZlN6byt6VENVRm5HdWpOOHVWWEdUVzB6RGlteDBpWUQK"
    }
  }
}
