# Rust workspace (not needed for apps/web)
target/
**/target/
crates/
Cargo.toml
Cargo.lock
rust-toolchain.toml

# Local release and git history
dist-release/
dist/
.git/
.verification/

# Desktop source is retained because the web asset-parity gate consumes the
# checked-in deterministic captures during Vercel builds. Exclude only build
# products, local dependencies, and app source that the site does not read.
apps/desktop/node_modules/
apps/desktop/src-tauri/
apps/desktop/src/
apps/desktop/dist/
apps/desktop/storybook-static/
apps/desktop-export/
apps/demo-video/
apps/docs/

# Tooling / benchmarks. tooling/scripts stays: the site's favicon build
# imports its ICO encoder.
tooling/acceptance/
tooling/benchmarks/
tooling/demos/
tooling/test-envs/
tooling/node_modules/
tooling/package.json
tooling/package-lock.json

# Tests & fixtures
tests/

# Cloud sandbox sibling (if present)
pytxo-cloud-sandbox/

# IDE / local
.pytxo/
.idea/
docs/.obsidian/

# Web install/build products. Keep content/docs — that is the public docs source.
apps/web/node_modules/
apps/web/.next/
apps/web/.docs-vault/
apps/web/test-results/
apps/web/.playwright-cli/
apps/web/output/
