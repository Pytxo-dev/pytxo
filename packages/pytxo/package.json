{
  "name": "pytxo",
  "version": "2.0.1",
  "description": "Land all your agents' branches in one command. Pytxo merges your Claude Code, Codex and Copilot branches in a throwaway worktree, runs your tests on the combined result, and lands what passes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pytxo-dev/pytxo-releases.git"
  },
  "homepage": "https://pytxo.com",
  "bugs": "https://github.com/Pytxo-dev/pytxo-releases/issues",
  "keywords": [
    "pytxo",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "coding-agents",
    "ai-agents",
    "git",
    "worktree",
    "merge",
    "ci",
    "tests"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pytxo": "bin/pytxo.js"
  },
  "files": [
    "bin",
    "lib",
    "postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node postinstall.js",
    "test": "node --test test/*.test.js"
  }
}
