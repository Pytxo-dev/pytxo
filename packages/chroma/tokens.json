{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "pytxo-chroma",
  "version": "0.5.0",
  "description": "Machine-readable Chroma ribbon tokens. Sync with tokens.css and crates/pytxo-tui/src/theme.rs",
  "colors": {
    "void": { "hex": "#050507", "rgb": [5, 5, 7] },
    "card": { "hex": "#111113", "rgb": [17, 17, 19] },
    "foreground": { "hex": "#EDEDEF", "rgb": [237, 237, 239] },
    "mutedForeground": { "hex": "#A1A1AA", "rgb": [161, 161, 170] },
    "border": { "hex": "#2A2A2E", "rgb": [42, 42, 46] },
    "brandViolet": { "hex": "#C44BFF", "rgb": [196, 75, 255] },
    "brandMagenta": { "hex": "#FF4B9A", "rgb": [255, 75, 154] },
    "brandOrange": { "hex": "#FF6A3D", "rgb": [255, 106, 61] },
    "brandGold": { "hex": "#F5C542", "rgb": [245, 197, 66] },
    "brandTeal": { "hex": "#7BE07A", "rgb": [123, 224, 122] },
    "brandCyan": { "hex": "#3EE0D0", "rgb": [62, 224, 208] },
    "ok": { "hex": "#7BE07A", "rgb": [123, 224, 122] },
    "err": { "hex": "#D96B6B", "rgb": [217, 107, 107] }
  },
  "chromaCycle": ["brandViolet", "brandMagenta", "brandOrange", "brandGold", "brandTeal", "brandCyan"],
  "radius": "0.375rem"
}
