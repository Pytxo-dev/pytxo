{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "...",
        "cargo build --release --manifest-path services/pytxo-link/Cargo.toml",
        "mkdir -p bin",
        "cp target/release/pytxo-link bin/"
      ]
    }
  },
  "deploy": {
    "startCommand": "./bin/pytxo-link"
  }
}
