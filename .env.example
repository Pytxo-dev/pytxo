# Pytxo monorepo environment reference (never commit real secrets)



# --- CLI / orchestration ---

RUST_LOG=info

PYTXO_ULTRA_SESSION=

PYTXO_CLOUD_SESSION=

PYTXO_SIDECAR=



# --- Pytxo Link (billing / entitlements) ---

LINK_BIND=127.0.0.1:8787

LINK_API_KEY=

LINK_ADMIN_KEY=

LINK_ADMIN_URL=https://link.pytxo.com

# Loopback development may be unauthenticated. Any non-loopback/PORT bind
# refuses startup unless auth is enabled and an authenticator is configured.
LINK_REQUIRE_AUTH=0

DATABASE_URL=

CLERK_ISSUER=

CLERK_JWKS_URL=

# Experimental website-to-Desktop Routing account return. Leave off until
# signed Clerk sessions carry the routing audience and Link has Postgres/JWKS.
LINK_ROUTING_TOKEN_EXPERIMENT=0
# Link-side switch for new Routing connections, grants and evaluation tokens.
# Leave off for revoke-only recovery; never inferred from website/Desktop flags.
LINK_ROUTING_GRANT_EXPERIMENT=0
ROUTING_CLERK_AUDIENCE=

PADDLE_WEBHOOK_SECRET=

PADDLE_PRICE_PRO=

PADDLE_PRICE_MAX=

PADDLE_PRICE_ULTRA=



# --- Pytxo Cloud sandbox (Max tier) ---

CLOUD_BIND=127.0.0.1:8788

CLOUD_API_KEY=

# Loopback development may be unauthenticated. Hosted/public binds require 1
# and a non-empty CLOUD_API_KEY or the service refuses startup.
CLOUD_REQUIRE_AUTH=0

# Required in addition to [cloud].upload_consent = true.
PYTXO_CLOUD_UPLOAD_CONSENT=

# Required in addition to [cloud].fallback_local = true.
PYTXO_CLOUD_FALLBACK_LOCAL=



# --- Web (Clerk + MBCZ billing) ---

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

CLERK_SECRET_KEY=

# Enables new one-time account returns; recovery and account-wide revocation
# remain available when off. Hosted advice/paid sends stay off.
NEXT_PUBLIC_ROUTING_BRIDGE_EXPERIMENT=0
PYTXO_ROUTING_BRIDGE_EXPERIMENT=0
LINK_ROUTING_BRIDGE_URL=https://link.pytxo.com

# Desktop-only experimental origins. Match the web bridge Link origin.
# Release builds require HTTPS; debug builds also permit loopback.
PYTXO_ROUTING_BRIDGE_SITE_ORIGIN=https://pytxo.com
PYTXO_ROUTING_BRIDGE_LINK_ORIGIN=https://link.pytxo.com

MBCZ_CHECKOUT_BASE_URL=https://mbcz.xyz

MBCZ_CHECKOUT_API_KEY=

# --- Release / distribution ---

PYTXO_BINARY=

PYTXO_SKIP_DOWNLOAD=

NPM_TOKEN=

PYTXO_RELEASES_TOKEN=

TAURI_SIGNING_PRIVATE_KEY=

TAURI_SIGNING_PRIVATE_KEY_PASSWORD=



# --- Railway observability (Link + Cloud only) ---

OTEL_EXPORTER_OTLP_ENDPOINT=

SENTRY_DSN=
