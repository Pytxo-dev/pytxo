max_agents = 3
worktree_dir = ".pytxo/worktrees"
data_dir = ".pytxo/data"
fail_fast = true
sanitize = true
dag_explicit_deps = false

[[agent]]
name = "builder"
paths = ["src/**"]

[[task]]
id = "task-a"
agent = "builder"
paths = ["src/a.ts"]
depends_on = []

[[task]]
id = "task-b"
agent = "builder"
paths = ["package.json"]
depends_on = ["task-a"]

[[task]]
id = "task-c"
agent = "builder"
paths = ["package.json"]
