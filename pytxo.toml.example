max_agents = 3
worktree_dir = ".pytxo/worktrees"
data_dir = ".pytxo/data"
fail_fast = true
# Local trust ladder: deep_space | orbit (default) | galaxy | supernova
permission_profile = "orbit"
sanitize = true
dag_explicit_deps = false
signal_core = true
signal_fidelity = "low"
isolation = "worktree"
execution_backend = "pty"
# subprocess_stdin = true   # pump Race Shield stdin queue when using subprocess backend
# execution_backend = "cloud"  # requires a configured non-noop cloud dispatcher
pty_rows = 24
pty_cols = 80
tier_max_agents = 3

# Blast Shield overlay tuning (Phase 62)
# [blast]
# prefer_kernel_overlay = true   # use overlay when doctor probe passes (default true)
# sparse_exclude = ["node_modules", ".git", "target", "dist", "build"]

# Optional NL mission planner for Hypervisor Shell (v0.2.x)
# [planner]
# enabled = true

# Advisory model for planning, future route ranking, and diagnosis. Model egress
# remains disabled unless the caller explicitly sets PYTXO_PLANNER_LLM=1.
# [coordinator]
# provider = "deepseek"
# model = "deepseek-flash"
# transport = "direct"   # direct | managed
# Local replacement: provider = "ollama", model = "qwen3:8b", transport = "direct"

# Pytxo Ultra local wallet + optional managed transport.
# Managed inference and Link reconciliation require configured services.
# [billing]
# mode = "ultra"
# proxy_url = "https://link.pytxo.com"           # Pytxo Link base URL (billing + entitlements)
# inference_proxy_url = "https://proxy.pytxo.com" # Ultra managed-inference proxy (ADR-0024)
# link_reconcile = true                         # attempts Link only when configured and reachable
# reserve_microcredits = 500000
# initial_balance_microcredits = 10000000

# Pytxo Cloud sandbox + Pro context cache (capability-gated; not a default hosted path)
# [cloud]
# enabled = true
# sandbox_url = "https://cloud.pytxo.com/v1"
# cache_url = "https://cloud.pytxo.com/v1"
# cache_enabled = true
# upload_consent = true  # also requires the out-of-band PYTXO_CLOUD_UPLOAD_CONSENT acknowledgement
# fallback_local = true   # Also requires PYTXO_CLOUD_FALLBACK_LOCAL=I_UNDERSTAND_CLOUD_FAILURE_WILL_RUN_LOCALLY

# MCP hub v2 — bidirectional proxy to child agent MCP servers
# [mcp_hub]
# enabled = true
# allowlist = ["cursor", "claude"]

[[agent]]
name = "builder"
paths = ["src/**"]
# Worker-model example (separate from the coordinator profile):
# model = "deepseek-chat"
# provider = "deepseek"
# cli_adapter = "generic"
# api_key_env = "DEEPSEEK_API_KEY"   # BYOK only; omit under billing.mode = ultra

[[task]]
id = "task-a"
agent = "builder"
paths = ["src/a.ts"]
depends_on = []
# root = "api"              # modular project only: run this task on labeled root
# signal_fidelity = "low"   # optional per-task override

[[task]]
id = "task-b"
agent = "builder"
paths = ["package.json"]
depends_on = ["task-a"]

[[task]]
id = "task-c"
agent = "builder"
paths = ["package.json"]
